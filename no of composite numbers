import java.util.*;
class Q14 {
 static boolean prime(int n){
  if(n<2)return false;
  for(int i=2;i*i<=n;i++)if(n%i==0)return false;
  return true;
 }
 public static void main(String[] a){
  Scanner s=new Scanner(System.in);
  int n=s.nextInt(),c=0;
  while(n-->0){int x=s.nextInt();if(x>1&&!prime(x))c++;}
  System.out.println(c);
 }
}
