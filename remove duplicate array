import java.util.*;
class Q42 {
 public static void main(String[] a) {
  Scanner s=new Scanner(System.in);
  int n=s.nextInt();int[] x=new int[n];
  for(int i=0;i<n;i++)x[i]=s.nextInt();
  for(int i=0;i<n;i++){
   boolean b=false;
   for(int j=0;j<i;j++)if(x[i]==x[j])b=true;
   if(!b)System.out.print(x[i]+" ");
  }
 }
}
