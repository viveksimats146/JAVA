import java.util.*;
class Q30 {
 static boolean p(int n){
  if(n<2)return false;
  for(int i=2;i*i<=n;i++)if(n%i==0)return false;
  return true;
 }
 public static void main(String[] a){
  Scanner s=new Scanner(System.in);
  int n=s.nextInt(),pr=0,co=0;
  while(n-->0){
   int x=s.nextInt();
   if(p(x))pr++;
   else if(x>1)co++;
  }
  System.out.println("Prime="+pr+" Composite="+co);
 }
}
