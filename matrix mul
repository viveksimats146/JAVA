import java.util.*;
class Q46 {
 public static void main(String[] a) {
  Scanner s=new Scanner(System.in);
  int[][] x=new int[2][2],y=new int[2][2],z=new int[2][2];
  for(int i=0;i<2;i++)for(int j=0;j<2;j++)x[i][j]=s.nextInt();
  for(int i=0;i<2;i++)for(int j=0;j<2;j++)y[i][j]=s.nextInt();

  for(int i=0;i<2;i++)
   for(int j=0;j<2;j++)
    for(int k=0;k<2;k++)
     z[i][j]+=x[i][k]*y[k][j];

  for(int i=0;i<2;i++){
   for(int j=0;j<2;j++)System.out.print(z[i][j]+" ");
   System.out.println();
  }
 }
}
