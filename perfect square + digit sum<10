import java.util.*;

class Q9 {
    static int sum(int n) {
        int s = 0;
        while (n > 0) {
            s += n % 10;
            n /= 10;
        }
        return s;
    }

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int low = sc.nextInt();
        int high = sc.nextInt();

        for (int i = low; i <= high; i++) {
            int r = (int)Math.sqrt(i);

            if (r * r == i && sum(i) < 10)
                System.out.print(i + " ");
        }
    }
}
