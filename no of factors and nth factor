import java.util.*;

class Q3 {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int n = sc.nextInt();
        int k = sc.nextInt();
        int count = 0, nth = -1;

        for (int i = 1; i <= n; i++) {
            if (n % i == 0) {
                count++;
                if (count == k)
                    nth = i;
            }
        }

        System.out.println("Number of factors = " + count);
        System.out.println(k + "th factor = " + nth);
    }
}
