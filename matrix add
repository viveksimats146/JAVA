import java.util.*;
class Q11 {
 public static void main(String[] a) {
  Scanner s=new Scanner(System.in);
  int[][] x=new int[2][2],y=new int[2][2];
  for(int i=0;i<2;i++)for(int j=0;j<2;j++)x[i][j]=s.nextInt();
  for(int i=0;i<2;i++)for(int j=0;j<2;j++)y[i][j]=s.nextInt();
  for(int i=0;i<2;i++){
   for(int j=0;j<2;j++)System.out.print((x[i][j]+y[i][j])+" ");
   System.out.println();
  }
 }
}
