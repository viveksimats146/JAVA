import java.util.*;

class Q8 {
    static int value(char c) {
        switch (c) {
            case 'I': return 1;
            case 'V': return 5;
            case 'X': return 10;
            case 'L': return 50;
            case 'C': return 100;
            case 'D': return 500;
            case 'M': return 1000;
        }
        return 0;
    }

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        String s = sc.next();

        int ans = 0;

        for (int i = 0; i < s.length(); i++) {
            int x = value(s.charAt(i));

            if (i + 1 < s.length() && x < value(s.charAt(i + 1)))
                ans -= x;
            else
                ans += x;
        }

        System.out.println(ans);
    }
}
